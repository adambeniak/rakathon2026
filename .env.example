# Copy to .env and fill in. Never commit .env. Agents are blocked (best effort) from reading it.
# Keep comments on their own lines: no inline comments after values.

# --- Azure APIM gateway (OpenAI-compatible) ---
APIM_BASE_URL=https://apim-XXXX.azure-api.net/openai/v1
APIM_API_KEY=
# Deployment names from the participant portal (check exact names there)
LLM_MODEL_EXTRACT=gpt-6-1-sol-dz-eu
LLM_MODEL_FAST=
# Leave empty to use the local multilingual embedding model in the backend
EMBEDDING_MODEL=

# --- IRIS for Health ---
# Local docker: localhost. Team ACI: the FQDN printed by scripts/aci_status.sh (stafeta-team73.swedencentral.azurecontainer.io)
IRIS_HOST=localhost
IRIS_WEB_PORT=52773
IRIS_SUPERSERVER_PORT=1972
IRIS_NAMESPACE=FHIRSERVER
IRIS_USER=_SYSTEM
# Same value as .iris/password.txt (local) or the ACI secret
IRIS_PASSWORD=
# Must point to the same host as IRIS_HOST
FHIR_BASE_URL=http://localhost:52773/fhir/r4

# Backend: at most 3 DB-API connections (community edition allows 8 in total); FHIR HTTP timeout in seconds
IRIS_POOL_SIZE=3
HTTP_TIMEOUT_S=30

# --- App ---
# local | ci | test | azure. Anything other than local/ci/test refuses the default JWT_SECRET and "*" in CORS_ORIGINS.
STAFETA_ENV=local
# 1 = tag every FHIR write with stafeta-demo so `make demo-reset` can wipe it (AuditEvents are never deleted)
STAFETA_DEMO_MODE=1
# 1 = use cached LLM responses (demo/CI), 0 = call APIM
STAFETA_LLM_CACHE=1
# Simulated "now" for the demo, with offset, e.g. 2026-10-21T08:00:00+02:00
STAFETA_DEMO_NOW=
JWT_SECRET=change-me-local-only
SMTP_HOST=localhost
SMTP_PORT=1025
# JSON list of allowed browser origins (Vite dev server)
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# 1 = JSON log lines (default), 0 = human-readable console output
LOG_JSON=1
