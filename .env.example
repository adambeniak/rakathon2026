# Copy to .env and fill in. Never commit .env. Agents are blocked (best effort) from reading it.
# Keep comments on their own lines: no inline comments after values.

# --- Azure APIM gateway (OpenAI-compatible) ---
APIM_BASE_URL=https://apim-XXXX.azure-api.net/openai/v1
APIM_API_KEY=
# Deployment names from the participant portal (check exact names there)
LLM_MODEL_EXTRACT=gpt-6-1-sol-dz-eu
LLM_MODEL_FAST=
# Leave empty to use the local multilingual embedding model in the backend
EMBEDDING_MODEL=

# --- IRIS for Health ---
# Local docker: localhost. Team ACI: the FQDN printed by scripts/aci_status.sh (stafeta-team73.swedencentral.azurecontainer.io)
IRIS_HOST=localhost
IRIS_WEB_PORT=52773
IRIS_SUPERSERVER_PORT=1972
IRIS_NAMESPACE=FHIRSERVER
IRIS_USER=_SYSTEM
# Same value as .iris/password.txt (local) or the ACI secret
IRIS_PASSWORD=
# Must point to the same host as IRIS_HOST
FHIR_BASE_URL=http://localhost:52773/fhir/r4

# --- App ---
STAFETA_ENV=local
# 1 = use cached LLM responses (demo/CI), 0 = call APIM
STAFETA_LLM_CACHE=1
# Simulated "now" for the demo, e.g. 2026-10-21T08:00:00+02:00
STAFETA_DEMO_NOW=
JWT_SECRET=change-me-local-only
SMTP_HOST=localhost
SMTP_PORT=1025
