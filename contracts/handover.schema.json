    "Finding": {
      "additionalProperties": false,
      "properties": {
        "docs": {
          "description": "doc_ids involved.",
          "items": {
            "type": "string"
          },
          "title": "Docs",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
