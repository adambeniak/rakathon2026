  "$id": "https://stafeta.example/contracts/handover.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Handover for one case. Documents count only if authored <= as_of AND received <= as_of.",
  "properties": {
    "as_of": {
      "description": "Cut-off timestamp, e.g. MDT start 2026-10-21T08:00:00+02:00.",
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "excluded_documents": {
      "items": {
        "$ref": "#/$defs/ExcludedDocument"
      },
      "title": "Excluded Documents",
      "type": "array"
    },
    "fields": {
      "$ref": "#/$defs/HandoverFields"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "included_documents": {
      "description": "doc_ids used for this handover.",
      "items": {
        "type": "string"
      },
      "title": "Included Documents",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "as_of",
    "included_documents",
    "fields"
  ],
  "title": "Handover",
  "type": "object"
}
