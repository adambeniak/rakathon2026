        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Affected handover field or path, e.g. '3_diagnosis.tnm'.",
          "title": "Field"
        },
        "id": {
          "description": "Stable id referenced from handover fields, e.g. 'C1'.",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "message": {
          "description": "Neutral Czech description of what is inconsistent or missing.",
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Workflow action, e.g. 'create_verification_task'.",
          "title": "Suggested Action"
        }
      },
      "required": [
        "id",
        "kind",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
