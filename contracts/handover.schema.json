      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A verbatim (whitespace-normalised) quote from a source document.\n\nThe golden file (`data/golden`) names the document key `doc`; the API and code use `doc_id`.",
      "properties": {
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Offset of the quote in the normalised text.",
          "title": "Char Start"
        },
        "doc_id": {
          "description": "File stem of the source document.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
          "title": "Doc Id",
          "type": "string"
        },
        "quote": {
          "description": "Must occur verbatim in the normalised document text.",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Examination": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
