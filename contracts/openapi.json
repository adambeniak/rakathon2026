  "info": {
    "description": "Shared oncology patient case (Rakathon 2026, VZP challenge). Fictitious data only.",
    "title": "Štafeta API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/cases": {
      "get": {
        "operationId": "cases-list_cases",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseSummary"
                  },
                  "title": "Response Cases-List Cases",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error (application/problem+json)"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "FHIR storage rejected the operation (application/problem+json)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "IRIS unavailable (application/problem+json)"
          }
        },
        "summary": "List cases",
        "tags": [
          "cases"
        ]
      }
    },
    "/api/cases/{case_id}": {
      "get": {
        "operationId": "cases-get_case",
        "parameters": [
          {
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "examples": [
                "rakathon-2026-prochazkova"
              ],
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*$",
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not found (application/problem+json)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request validation failed (application/problem+json)"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected server error (application/problem+json)"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "FHIR storage rejected the operation (application/problem+json)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "IRIS unavailable (application/problem+json)"
          }
        },
        "summary": "Case detail with its documents",
        "tags": [
          "cases"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "IRIS degraded"
          }
        },
        "summary": "Backend and IRIS health",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Backend and IRIS status.",
      "name": "health"
    },
